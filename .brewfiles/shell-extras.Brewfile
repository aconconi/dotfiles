# shell-extras.Brewfile
# Useful but non-essential shell tools: comfort, system/network monitoring,
# editors, git, networking/HTTP.
# Install with: brew bundle --file=shell-extras.Brewfile

brew "bandwhich"  # Real-time network bandwidth monitor (Rust, TUI)
brew "btop"       # Full-screen resource monitor (C++)
brew "doggo"      # Human-readable DNS client (Go)
brew "dua-cli"    # Interactively inspect and free disk space
brew "dust"       # Intuitive du alternative with a tree view (Rust)
brew "gping"      # Ping with a live terminal graph (Rust, TUI)
brew "grc"        # Colorize logs and output from commands such as ping and traceroute
brew "htop"       # Lightweight interactive process viewer for slow SSH links
brew "just"       # Save and run project-specific commands
brew "macchina"   # Minimal cross-platform system information fetcher (Rust)
brew "models"     # Browse AI models, benchmarks, and coding agents
brew "netwatch"   # Real-time network diagnostics
brew "rustscan"   # Fast port scanner and nmap alternative (Rust)
brew "sevenzip"   # 7-Zip archiver
brew "shellcheck" # Static analysis and linting for shell scripts
brew "tealdeer"   # Fast tldr client for simplified man pages (Rust)
brew "topgrade"   # Upgrade all system package managers
brew "unar"       # Command-line unarchiver supporting multiple formats
brew "vivid"      # Generate LS_COLORS with theme support (Rust)
brew "yazi"       # Fast terminal file manager with async I/O (Rust)
brew "zoxide"     # Frecency-based cd replacement
