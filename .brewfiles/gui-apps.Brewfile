# gui-apps.Brewfile
# Desktop applications with a graphical interface (cask). macOS only:
# casks are not supported by Linuxbrew/Ubuntu.
# Install with: brew bundle --file=gui-apps.Brewfile

cask "drawio"       # Diagramming editor with offline support
cask "ghostty"      # Terminal emulator with a native UI and GPU acceleration
cask "macdown-3000" # Markdown editor with live preview and syntax highlighting
cask "obsidian"     # Knowledge base backed by a local folder of Markdown files
cask "whatsapp"     # Native desktop client for WhatsApp
cask "zettlr"       # Open-source Markdown editor
