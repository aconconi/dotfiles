# gui-apps.Brewfile
# Desktop applications with a graphical interface (cask). macOS only:
# casks are not supported by Linuxbrew/Ubuntu.
# Install with: brew bundle --file=gui-apps.Brewfile

# Diagramming editor, works offline too
cask "drawio"

# Terminal emulator with native platform UI and GPU acceleration
cask "ghostty"

# Markdown editor with live preview and syntax highlighting
cask "macdown-3000"

# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"

# Native desktop client for WhatsApp
cask "whatsapp"

# Open-source markdown editor
cask "zettlr"
