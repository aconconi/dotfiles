# macos-specific.Brewfile
# Formulae and casks that depend on macOS-specific APIs or features: do NOT work on
# Linuxbrew/Ubuntu. Install with: brew bundle --file=macos-specific.Brewfile

brew "duti"         # Set default applications for file types and URL schemes
brew "mas"          # Install and manage apps from the Mac App Store
brew "mole"         # Clean, uninstall, analyze, optimize, and monitor macOS

cask "macdown-3000" # Markdown editor for macOS with live preview and syntax highlighting
cask "macmon"       # Sudoless Apple Silicon performance monitoring
cask "whatsapp"     # Native WhatsApp desktop client; no Linux version is available
#cask "rectangle"   # Move and resize windows with the keyboard or snap areas
#cask "utm"         # QEMU-based virtual machine UI with native macOS integration
#cask "lima"        # Manage Linux virtual machines on a macOS host
#cask "multipass"   # Ubuntu virtual machine manager
