# other-useful-tools.Brewfile
# Miscellaneous utilities without a semantic domain large enough to justify
# a dedicated file: API client, media, reading, documents.
# Install with: brew bundle --file=other-useful-tools.Brewfile

brew "atac"         # Postman-like terminal API client (TUI)
brew "cmus"         # Terminal music player with an ncurses interface
brew "bookokrat"    # Terminal EPUB reader (TUI)
brew "lynx"         # Text-based web browser
brew "w3m"          # Text-based pager and browser; alternative to lynx
brew "himalaya"     # Terminal email client (Rust, TUI)
brew "pastel"       # Generate, analyze, and manipulate colors (Rust)
brew "yt-dlp"       # Audio and video downloader; maintained fork of youtube-dl
brew "imagemagick"  # Manipulate images in many formats
brew "ghostscript"  # PostScript and PDF interpreter used by graphics tools
brew "poppler"      # Render and extract content from PDFs
brew "glow"         # Render styled Markdown in the terminal
brew "mdcat"        # Minimal Markdown viewer for text terminals
brew "marp-cli"     # Convert Marp Markdown into HTML, PDF, PPT, or images
brew "mermaid-cli"  # Generate diagrams from Mermaid text
brew "silicon"      # Create images of source code snippets (Rust)
