# fonts.Brewfile
# Monospace fonts for terminal/editor use (cask). macOS only.
# Install with: brew bundle --file=fonts.Brewfile

# Inconsolata monospace font
cask "font-inconsolata"

# JetBrains Mono monospace font
cask "font-jetbrains-mono"

# JetBrains Mono with Nerd Font icons built in (for prompts like starship)
cask "font-jetbrains-mono-nerd-font"
