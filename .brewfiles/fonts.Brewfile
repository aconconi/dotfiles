# fonts.Brewfile
# Monospace fonts for terminal/editor use (cask). macOS only.
# Install with: brew bundle --file=fonts.Brewfile

cask "font-inconsolata"                 # Inconsolata monospace font
cask "font-jetbrains-mono"              # JetBrains Mono monospace font
cask "font-jetbrains-mono-nerd-font"    # JetBrains Mono with Nerd Font icons for prompts
