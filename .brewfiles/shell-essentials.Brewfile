# shell-essentials.Brewfile
# Terminal tools used daily, the minimum to be operational on a new shell.
# Install with: brew bundle --file=shell-essentials.Brewfile

brew "atuin"            # Syncable, searchable shell history (Rust)
brew "bat"              # cat clone with syntax highlighting and Git integration (Rust)
brew "btop"             # Full-screen resource monitor (C++)
brew "duf"              # Readable df alternative with usage bars (Go)
brew "eza"              # Modern ls replacement with icons and colors (Rust)
brew "fd"               # Fast, simple find alternative (Rust)
brew "fzf"              # Fuzzy finder used by shell keybindings (Go)
brew "ripgrep"          # Fast grep alternative (Rust)
brew "starship"         # Fast, customizable cross-shell prompt (Rust)
brew "stow"             # Manage dotfiles with symlinks; install before the other packages
brew "zsh-autocomplete" # Real-time type-ahead completion for Zsh
