# retro-emulators.Brewfile
# Emulators for historical computers, not needed for the work environment.
# Install with: brew bundle --file=retro-emulators.Brewfile

# Amiga emulator
cask "fs-uae-emulator"

# Launcher for the Amiga emulator
cask "fs-uae-launcher"

# Versatile Commodore emulator (C64 and others)
cask "vice"
