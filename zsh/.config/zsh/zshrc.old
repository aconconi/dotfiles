# ----------------------------------------
# Plugins
# ----------------------------------------
# uses plugin manager from https://satya164.page/posts/my-zsh-setup
[[ -f "$ZDOTDIR/my_plugin_manager.zsh" ]] && source "$ZDOTDIR/my_plugin_manager.zsh"


# ----------------------------------------
# Powerlevel10k
