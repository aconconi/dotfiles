# other-useful-tools.Brewfile
# Miscellaneous utilities without a semantic domain large enough to justify
# a dedicated file: API client, media, reading, documents.
# Install with: brew bundle --file=other-useful-tools.Brewfile

# Terminal API client, Postman-like (TUI)
brew "atac"

# Terminal music player with an ncurses interface (TUI)
brew "cmus"

# Terminal EPUB book reader (TUI)
brew "bookokrat"

# Text-based web browser (TUI)
brew "lynx"

# Text-based pager/browser, alternative to lynx (TUI)
brew "w3m"

# Terminal email client (Rust, TUI)
brew "himalaya"

# Generate, analyze, and manipulate colors from the command line (Rust)
brew "pastel"

# Command-line audio/video downloader, actively maintained fork of youtube-dl
brew "yt-dlp"

# Tools and libraries to manipulate images in various formats
brew "imagemagick"

# Interpreter for PostScript and PDF, common dependency for graphics/PDF tools
brew "ghostscript"

# Library for rendering and extracting content from PDFs
brew "poppler"

# Render markdown on the CLI with styling
brew "glow"

# Show markdown documents on text terminals, more minimal than glow
brew "mdcat"

# Converts Marp-flavored Markdown into HTML, PDF, PPT, or images
brew "marp-cli"

# CLI for the Mermaid diagram library, generates images from text
brew "mermaid-cli"

# Create elegant images of source code snippets (Rust)
brew "silicon"
