# shell-extras.Brewfile
# Useful but non-essential shell tools: comfort, system/network monitoring,
# editors, git, networking/HTTP.
# Install with: brew bundle --file=shell-extras.Brewfile

# See and free up disk space quickly, interactive
brew "dua-cli"

# More intuitive version of du, with tree view (Rust)
brew "dust"

# Colorizes the output of logs and common commands (ping, traceroute, etc.)
brew "grc"

# System information fetcher, minimal (Rust, cross-platform)
brew "macchina"

# Static analysis and lint tool for (ba)sh scripts
brew "shellcheck"

# Very fast implementation of tldr, simplified man pages (Rust)
brew "tealdeer"

# Upgrades all the system's package managers in one go
brew "topgrade"

# Generator for LS_COLORS with support for multiple themes (Rust)
brew "vivid"

# Terminal file manager (TUI), fast, async I/O (Rust)
brew "yazi"

# Modern port scanner, fast alternative to nmap for quick scans (Rust)
brew "rustscan"

# Command-line unarchiving tool supporting multiple formats
brew "unar"

# 7-Zip archiver
brew "sevenzip"

# Quickly counts lines of code per language (Rust)
brew "tokei"

# Navigate the filesystem faster, a cd/z replacement with frecency
brew "zoxide"

# Fast TUI/CLI for browsing AI models, benchmarks, and coding agents
brew "models"

# Classic, lightweight interactive process viewer, handy over slow SSH links
brew "htop"

# Real-time network bandwidth utilization monitor (TUI, Rust)
brew "bandwhich"

# Ping, but with a live graph in the terminal (TUI, Rust)
brew "gping"

# Official Amazon AWS command-line interface
brew "awscli"

# Command-line DNS client, human-readable output (Go)
brew "doggo"

# HTTP load generator with TUI animation, inspired by rakyll/hey (Rust)
brew "oha"

# High performance static file server, handy for local testing (Rust)
brew "miniserve"
