# macos-specific.Brewfile
# Casks that depend on macOS-specific APIs or features: do NOT work on
# Linuxbrew/Ubuntu. Install with: brew bundle --file=macos-specific.Brewfile

# Sudoless performance monitoring for Apple Silicon (uses proprietary Apple sensors)
cask "macmon"

# Move and resize windows via keyboard or snap areas (uses macOS window APIs)
cask "rectangle"

# Virtual machine UI based on QEMU, with native macOS integration
cask "utm"

# Linux virtual machines managed by macOS, designed to run on a macOS host
cask "lima"

# Ubuntu VM manager, distributed here as a macOS cask
cask "multipass"
