# shell-essentials.Brewfile
# Terminal tools used daily, the minimum to be operational on a new shell.
# Install with: brew bundle --file=shell-essentials.Brewfile

# Clone of cat with syntax highlighting and Git integration (Rust)
brew "bat"

# Modern replacement for ls, with icons and colors (Rust)
brew "eza"

# Simple and fast alternative to find (Rust)
brew "fd"

# Command-line fuzzy finder, also used in shell keybindings (Go)
brew "fzf"

# Text search tool like grep/ag, much faster (Rust)
brew "ripgrep"

# Cross-shell prompt, customizable and fast (Rust)
brew "starship"

# Save and run project-specific commands, a simplified Makefile
brew "just"

# Command-line HTTP client, syntax inspired by httpie but faster (Rust)
brew "xh"

# Organizes dotfiles/software under a single directory tree via symlinks
# Note: run this BEFORE installing the other packages, so tools find the
# config symlinks already in place at first launch and avoid conflicts
brew "stow"

# Full-screen resource monitor, evolution of bashtop/bpytop (C++)
brew "btop"

# Real-time type-ahead completion for Zsh
brew "zsh-autocomplete"

# Syncable and searchable shell history for zsh/bash/fish/nushell (Rust)
brew "atuin"

# More readable alternative to df, with usage bars (Go)
brew "duf"
